<div id="SectionButton" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-target-user-control="UserControls/Button_Mainscreen.usercontrol" data-tchmi-top="0" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-pathimage="Images/MainScreen.svg" data-tchmi-title="Section" data-tchmi-grid-column-index="1" data-tchmi-grid-row-index="1" data-tchmi-activatescreen="Contents/OverviewSection.content" data-tchmi-regioncontent="%ctrl%DesktopRegion::TargetContent%/ctrl%">
</div>
<div id="ErrorWarningButton" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-grid-column-index="3" data-tchmi-grid-row-index="1" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-target-user-control="UserControls/Button_Mainscreen.usercontrol" data-tchmi-top="0" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-pathimage="Images/Machine_Error.svg" data-tchmi-title="Error/Warning">
</div>
<div id="SettingButton" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-grid-column-index="5" data-tchmi-grid-row-index="1" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-target-user-control="UserControls/Button_Mainscreen.usercontrol" data-tchmi-top="0" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-pathimage="Images/Settings.svg" data-tchmi-title="Settings" data-tchmi-activatescreen="Contents/ADSSettings.content" data-tchmi-regioncontent="%ctrl%DesktopRegion::TargetContent%/ctrl%">
</div>

