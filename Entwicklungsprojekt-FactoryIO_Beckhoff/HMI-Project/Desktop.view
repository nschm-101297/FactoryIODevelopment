<div id="Desktop" data-tchmi-type="TcHmi.Controls.System.TcHmiView" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width-mode="Parent" data-tchmi-min-width="100" data-tchmi-min-width-unit="%" data-tchmi-height-mode="Value" data-tchmi-min-height="100" data-tchmi-min-height-unit="%" data-tchmi-width-unit="%" data-tchmi-height-unit="%" data-tchmi-width="100" data-tchmi-height="100" data-tchmi-creator-viewport-width="1024">
  <div id="DesktopContainer" data-tchmi-type="TcHmi.Controls.System.TcHmiGrid" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-width-mode="Value">

<script data-tchmi-target-attribute="data-tchmi-row-options" type="application/json">
[
  {
    "height": 200.0,
    "heightMode": "Value",
    "heightUnit": "px",
    "overflow": false
  },
  {
    "height": 1.0,
    "heightMode": "Value",
    "heightUnit": "factor"
  },
  {
    "height": 100.0,
    "heightMode": "Content",
    "heightUnit": "px"
  }
]
</script>
<div id="DesktopHeader" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-target-user-control="UserControls/Header.usercontrol" data-tchmi-top="0" data-tchmi-top-unit="px" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-pathimageoperatingmode="%s%ADS.PLC1.HMI.hmiHeaderInterface.PathOperatingMode%/s%" data-tchmi-pathimagemachinestate="%s%ADS.PLC1.HMI.hmiHeaderInterface.PathMachineState%/s%" data-tchmi-errorisactive="%s%ADS.PLC1.HMI.hmiHeaderInterface.ErrorIsActive%/s%" data-tchmi-state="%s%ADS.PLC1.HMI.hmiHeaderInterface.State%/s%" data-tchmi-nameapplication="%s%ADS.PLC1.HMI.hmiHeaderInterface.NameApplication%/s%" data-tchmi-height-mode="Value" data-tchmi-activatescreen="Contents/MainSelectionDesktop.content" data-tchmi-regioncontent="%ctrl%DesktopRegion::TargetContent%/ctrl%">
</div>
<div id="DesktopRegion" data-tchmi-type="TcHmi.Controls.System.TcHmiRegion" data-tchmi-grid-column-index="0" data-tchmi-grid-row-index="1" data-tchmi-height="100" data-tchmi-height-unit="px" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-target-content="Contents/MainSelectionDesktop.content" data-tchmi-height-mode="Parent" data-tchmi-min-height="100" data-tchmi-min-height-unit="%">



<script data-tchmi-target-attribute="data-tchmi-border-width" type="application/json">
{
  "left": 0,
  "right": 0,
  "top": 0,
  "bottom": 0,
  "leftUnit": "px",
  "rightUnit": "px",
  "topUnit": "px",
  "bottomUnit": "px"
}
</script>

<script data-tchmi-target-attribute="data-tchmi-border-style" type="application/json">
{
  "left": "None",
  "right": "None",
  "top": "None",
  "bottom": "None"
}
</script>
</div>
<div id="DesktopFooter" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-fourthbuttonvisibility="Collapsed" data-tchmi-grid-column-index="0" data-tchmi-grid-row-index="2" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-secondbuttonvisibility="Collapsed" data-tchmi-target-user-control="UserControls/Footer.usercontrol" data-tchmi-thirdbuttonvisibility="Collapsed" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-min-height="100">
</div>
</div>

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onInitialized",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "console.log('Desktop onInitialized gestartet');",
          "",
          "// 👉 globales Objekt anlegen (falls noch nicht vorhanden)",
          "window.hmiHeartbeat = window.hmiHeartbeat || {};",
          "",
          "// 👉 nur einmal starten (kein return erlaubt → deshalb if-Block)",
          "if (!window.hmiHeartbeat.started) {",
          "",
          "    window.hmiHeartbeat.started = true;",
          "",
          "    console.log('Heartbeat wird gestartet');",
          "",
          "    // 👉 Initialwerte",
          "    window.hmiHeartbeat.heartbeatValue = false;",
          "    window.hmiHeartbeat.timer = null;",
          "    window.hmiHeartbeat.timeout = null;",
          "    window.hmiHeartbeat.destroyWatch = null;",
          "",
          "    // 👉 Symbolpfade",
          "    var plcHeartbeatExpression = '%s%ADS.PLC1.HMI.hmiAdsCommunicationInterface.HeartbeatPLC%/s%';",
          "    var hmiConnectionStateExpression = '%i%bConnectionStatusPLCHMI%/i%';",
          "",
          "    // 👉 Verbindungsstatus setzen",
          "    function setConnectionState(isConnected) {",
          "        TcHmi.Symbol.writeEx(hmiConnectionStateExpression, isConnected, function (data) {",
          "            if (data.error !== TcHmi.Errors.NONE) {",
          "                console.log('Fehler beim Schreiben Verbindungsstatus:', data.error);",
          "            }",
          "        });",
          "    }",
          "",
          "    // 👉 Timeout neu starten",
          "    function restartHeartbeatTimeout() {",
          "        if (window.hmiHeartbeat.timeout !== null) {",
          "            clearTimeout(window.hmiHeartbeat.timeout);",
          "        }",
          "",
          "        window.hmiHeartbeat.timeout = setTimeout(function () {",
          "            console.log('Timeout -> Verbindung verloren');",
          "            setConnectionState(false);",
          "        }, 2000);",
          "    }",
          "",
          "    // 👉 Timer (HMI → PLC)",
          "    window.hmiHeartbeat.timer = setInterval(function () {",
          "        window.hmiHeartbeat.heartbeatValue = !window.hmiHeartbeat.heartbeatValue;",
          "",
          "        TcHmi.Symbol.writeEx(",
          "            '%s%ADS.PLC1.HMI.hmiAdsCommunicationInterface.HeartbeatHMI%/s%',",
          "            window.hmiHeartbeat.heartbeatValue,",
          "            function (data) {",
          "                if (data.error !== TcHmi.Errors.NONE) {",
          "                    console.log('Heartbeat schreiben fehlgeschlagen');",
          "                }",
          "            }",
          "        );",
          "    }, 500);",
          "",
          "    // 👉 Watch (PLC → HMI)",
          "    var heartbeatSymbol = new TcHmi.Symbol(plcHeartbeatExpression);",
          "",
          "    window.hmiHeartbeat.destroyWatch = heartbeatSymbol.watch(function (data) {",
          "        if (data.error === TcHmi.Errors.NONE) {",
          "            setConnectionState(true);",
          "            restartHeartbeatTimeout();",
          "        } else {",
          "            setConnectionState(false);",
          "        }",
          "    });",
          "",
          "}"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>