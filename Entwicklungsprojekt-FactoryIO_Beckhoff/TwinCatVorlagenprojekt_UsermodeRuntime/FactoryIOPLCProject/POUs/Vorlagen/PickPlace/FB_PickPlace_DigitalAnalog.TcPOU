    <Method Name="MoveXYAxis_On" Id="{1c860185-3e27-4a63-ad8e-32b68e0f419a}">
      <Declaration><![CDATA[METHOD PUBLIC MoveXYAxis_On : BOOL
VAR_INPUT
	StartMovePickPlaceX_YAxis	:	BOOL;
	Positions	:	PickPlacePosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF OperatingMode.AutomaticIsActive AND OperatingMode.AutomaticStart.IsActive AND
	NOT statMovePickPlace AND StartMovePickPlaceX_YAxis THEN
	SetPointXAxis := Positions.PositionXAxis;
	SetPointYAxis := Positions.PositionYAxis;
	statMovePickPlace := TRUE;
	MoveXYAxis_On := TRUE;
ELSE
	MoveXYAxis_On := FALSE;
END_IF ]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveZAxis_On" Id="{ce935367-21b0-4a62-b9d5-4366b5d5ef18}">
      <Declaration><![CDATA[METHOD PUBLIC MoveZAxis_On : BOOL
VAR_INPUT
	StartMovePickPlaceZAxis	:	BOOL;
	Positions	:	PickPlacePosition;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF OperatingMode.AutomaticIsActive AND OperatingMode.AutomaticStart.IsActive AND
	NOT statMovePickPlace AND StartMovePickPlaceZAxis THEN
	SetPointZAxis := Positions.PositionZAxis;
	statMovePickPlace := TRUE;
	MoveZAxis_On := TRUE;
ELSE
	MoveZAxis_On := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReleasePart" Id="{971e9852-3dda-4aed-a566-f8a18218139b}">
      <Declaration><![CDATA[METHOD PUBLIC ReleasePart : BOOL
VAR_INPUT
	StartGrabPart	:	BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF OperatingMode.AutomaticIsActive AND OperatingMode.AutomaticStart.IsActive AND
	InPositionX_Y_Axis AND InPositionZAxis AND StartGrabPart AND NOT statMovePickPlace 
THEN
	statGrabPart := FALSE;
	ReleasePart := TRUE;
ELSE
	ReleasePart := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RotateGripperTo0" Id="{9f6cf1d8-002f-43dd-8a88-2358afae811f}">
      <Declaration><![CDATA[METHOD PUBLIC RotateGripperTo0 : BOOL
VAR_INPUT
	StartMovingGripperTo0	:	BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF OperatingMode.AutomaticIsActive AND OperatingMode.AutomaticStart.IsActive AND
	InPositionX_Y_Axis AND InPositionZAxis AND StartMovingGripperTo0 AND NOT statMoveStackerCrane 
THEN
	statCAxisToPos90 := FALSE;
	RotateGripperTo0 := TRUE;
ELSE
	RotateGripperTo0 := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RotateGripperTo90" Id="{8552f2b3-9a4f-4fe7-910a-5c9fe9b86365}">
