    <Property Name="SetPointXAxis" Id="{20e5a083-81f4-4086-a50c-ba9d29e556e9}">
      <Declaration><![CDATA[PROPERTY PUBLIC SetPointXAxis : REAL]]></Declaration>
      <Get Name="Get" Id="{eb133756-764c-4139-8902-c12ff755b996}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SetPointXAxis := statSetPointXAxis;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{b1797e69-fb4c-454c-9d7a-93ed5aa0f638}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF SetPointXAxis < 10.5 THEN
	statSetPointXAxis := SetPointXAxis;
END_IF]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="SetPointYAxis" Id="{923038f5-562f-44ab-8e58-4e68056d1083}">
      <Declaration><![CDATA[PROPERTY PUBLIC SetPointYAxis : Real]]></Declaration>
      <Get Name="Get" Id="{c4d80d3a-81e6-4330-982d-323a5a0f9e4b}">
        <Declaration><![CDATA[VAR
