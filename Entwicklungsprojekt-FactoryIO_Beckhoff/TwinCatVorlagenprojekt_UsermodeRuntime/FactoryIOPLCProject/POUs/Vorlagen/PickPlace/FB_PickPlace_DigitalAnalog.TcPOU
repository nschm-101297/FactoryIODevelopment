      <Get Name="Get" Id="{d1f45157-57eb-4d2f-8927-9c7f7d0abd3a}">
        <Declaration><![CDATA[
]]></Declaration>
        <Implementation>
          <ST><![CDATA[InPositionX_Y_Axis := statPickPlaceInPositionXAxis;]]></ST>
