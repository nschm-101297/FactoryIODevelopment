<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PickPlace_DigitalAnalog" Id="{d58bf5ee-4949-4676-bf3d-5ff4fb7c554c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PickPlace_DigitalAnalog
VAR_INPUT
	PickPlaceCurrentPositionXAxis	:	WORD;	//Raw value X axis
	PickPlaceCurrentPositionYAxis	:	WORD;	//Raw value Y axis
	PickPlaceCurrentPositionZAxis	:	WORD;	//Raw value Z axis
	PickPlaceX_YAxisStillMoving	:	BOOL;	//X and Y axis are moving
	PickPlaceZAxisStillMoving	:	BOOL;	//Z axis are moving
	PickPlaceBoxDetected	:	BOOL;	//Box detected on Gripper
	PickPlaceCAxisLimitReached	:	BOOL;	//C axis in Position
	ActorInstanceIndex	:	INT;	//Index in DropDown HMI
	ActorInstanceName	:	STRING;		//Name of the instance
END_VAR
VAR_OUTPUT
	SetPointToXAxis : WORD;	//Setpoint X axis
	SetPointToYAxis : WORD;	//Setpoint Y axis
	SetPointToZAxis : WORD;	//Setpoint Z axis
	GrabPart	:	BOOL;	//Grab a part
	RotateGripper	:	BOOL;	//Rotate gripper
END_VAR
VAR_IN_OUT
	OperatingMode	:	OperatingMode;	//Schnittstelle für Betriebsarten
	HMIInterface	:	MachineSectionHMIInterface;	//HMI-Interface
END_VAR
VAR
	statMovePickPlace	:	BOOL;
	statPickPlaceInPositionXAxis	:	BOOL;
	statPickPlaceInPositionYAxis	:	BOOL;
	statPickPlaceInPositionZAxis	:	BOOL;
	statPickPlaceInPositionCAxis90	:	BOOL;
	statCurrentPositionXAxis	: REAL;
	statCurrentPositionYAxis	: REAL;
	statCurrentPositionZAxis	: REAL;
	statSelectedSetPointXAxis	: REAL;
	statSelectedSetPointYAxis	: REAL;
	statSelectedSetPointZAxis	: REAL;
	statSetPointXAxis	:	REAL;
	statSetPointYAxis	:	REAL;
	statSetPointZAxis	:	REAL;
	statSetPointToXaxis	:	WORD;
	statSetPointToYaxis	:	WORD;
	statSetPointToZaxis	:	WORD;
	statCAxisToPos90	:	BOOL;
	statGrabPart	:	BOOL;
	statREX_YAxisMoving	:	R_TRIG;
	statREZAxisMoving	:	R_TRIG;
	statRECAxisMoving	:	R_TRIG;
	statFEX_YAxisMoving	:	F_TRIG;
	statFEZAxisMoving	:	F_TRIG;
	statFECAxisMoving	:	F_TRIG;
	
	internHMIInterface	:	MachineSectionHMIInterface;
	internInstanceActivatedFirstTime	:	BOOL;
	internRisingEdgePageSwitchUp	:	R_TRIG;
	internRisingEdgePageSwitchDown	:	R_TRIG;
	internRisingEdgePressButtonPlusXAxis	:	R_TRIG;
	internRisingEdgePressButtonMinusXAxis	:	R_TRIG;
	internRisingEdgePressButtonStopXAxis	:	R_TRIG;
	internRisingEdgePressButtonPlusYAxis	:	R_TRIG;
	internRisingEdgePressButtonMinusYAxis	:	R_TRIG;
	internRisingEdgePressButtonStopYAxis	:	R_TRIG;
	internRisingEdgePressButtonUpZAxis	:	R_TRIG;
	internRisingEdgePressButtonDownZAxis	:	R_TRIG;
	internRisingEdgePressButtonStopZAxis	:	R_TRIG;
	internRisingEdgePressButtonCAxisToPos90	:	R_TRIG;
	internRisingEdgePressButtonCAxisToPos0	:	R_TRIG;
	internRisingEdgePressButtonGrabPart	:	R_TRIG;
	internRisingEdgePressButtonReleasePart	:	R_TRIG;
	internStopXAxis	:	BOOL;
	internStopYAxis	:	BOOL;
	internStopZAxis	:	BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*===================== CurrentPosition Axes =====================*)
FC_AnalogInputValueHandling(RowValue:= PickPlaceCurrentPositionXAxis, 
							UpperLimit:= 2.125, 
							LowerLimit:= 0.0, 
							ConvertedValue=> statCurrentPositionXAxis);
FC_AnalogInputValueHandling(RowValue:= PickPlaceCurrentPositionYAxis, 
							UpperLimit:= 1.25, 
							LowerLimit:= 0.0, 
							ConvertedValue=> statCurrentPositionYAxis);
FC_AnalogInputValueHandling(RowValue:= PickPlaceCurrentPositionZAxis, 
							UpperLimit:= 0.5, 
							LowerLimit:= 0.0, 
							ConvertedValue=> statCurrentPositionZAxis);
(*===================== HMI INTERFACE =====================*)
internHMIInterface := HMIInterface;

IF internHMIInterface.ActiveMachineSection = MachineSection.StackerCrane AND
	internHMIInterface.SelectedActor = ActorInstanceIndex THEN
	(*===================== Initializing HMI-Interface =====================*)
	IF NOT internInstanceActivatedFirstTime THEN
		FC_InitializingSettingLines(HMIInterface := internHMIInterface);
		internInstanceActivatedFirstTime := TRUE;
	END_IF
	(*===================== Page switch =====================*)
	internRisingEdgePageSwitchUp(CLK := internHMIInterface.PageSwitch.NextPageIsPressed);
	internRisingEdgePageSwitchDown(CLK := internHMIInterface.PageSwitch.PreviousPageIsPressed);
	IF internRisingEdgePageSwitchUp.Q THEN
		internHMIInterface.PageSwitch.SelectedPage := internHMIInterface.PageSwitch.SelectedPage + 1; 
	END_IF
	IF internRisingEdgePageSwitchDown.Q THEN
		internHMIInterface.PageSwitch.SelectedPage := internHMIInterface.PageSwitch.SelectedPage - 1; 
	END_IF
	
	internHMIInterface.PageSwitch.MinPage := 1;
	internHMIInterface.PageSwitch.MaxPage := 2;
	internHMIInterface.PageSwitch.NextPageIsEnabled := internHMIInterface.PageSwitch.SelectedPage < internHMIInterface.PageSwitch.MaxPage;
	internHMIInterface.PageSwitch.PreviousPageIsEnabled := internHMIInterface.PageSwitch.SelectedPage < internHMIInterface.PageSwitch.MinPage;
	(*===================== Button Handling Movement =====================*)
	IF internHMIInterface.PageSwitch.SelectedPage = 1 THEN
		internHMIInterface.Movements.MovementSettingLines[1].CaptionSettingLine := CONCAT('StackerCrane X-Axis Control ', ActorInstanceName);
		internHMIInterface.Movements.MovementSettingLines[1].VisibilitySettingLine := TRUE;
		
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].IsVisibleButton := TRUE;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].IsVisibleAxisPosition := FALSE;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].IsEnabled := OperatingMode.ManuelIsActive AND NOT
										 														OperatingMode.EStop.IsActive AND NOT
																								OperatingMode.Fault.IsActive AND NOT
																								statMovePickPlace AND
																								statSetPointXAxis < 2.215;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].InPosition := statPickPlaceInPositionXAxis;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].CaptionButton := 'Plus';
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].PathImageButton := 'Images\ForwardConveyor.svg';
		
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].IsVisibleButton := TRUE;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].IsVisibleAxisPosition := TRUE;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].IsEnabled := OperatingMode.ManuelIsActive;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].InPosition := NOT statMovePickPlace;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].AxisPosition := statCurrentPositionXAxis;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].CaptionButton := 'Stop';
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].PathImageButton := 'Images\StopConveyor.svg';
		
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].IsVisibleButton := TRUE;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].IsVisibleAxisPosition := FALSE;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].IsEnabled := OperatingMode.ManuelIsActive AND NOT
										 														OperatingMode.EStop.IsActive AND NOT
																								OperatingMode.Fault.IsActive AND NOT
																								statMovePickPlace AND
																								statSetPointXAxis > 0;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].InPosition := statPickPlaceInPositionXAxis;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].CaptionButton := 'Minus';
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].PathImageButton := 'Images\BackwardConveyor.svg';
		
		internHMIInterface.Movements.MovementSettingLines[2].CaptionSettingLine := CONCAT('StackerCrane Y-Axis Control ', ActorInstanceName);
		internHMIInterface.Movements.MovementSettingLines[2].VisibilitySettingLine := TRUE;
		
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].IsVisibleButton := TRUE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].IsVisibleAxisPosition := FALSE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].IsEnabled := OperatingMode.ManuelIsActive AND NOT
										 														OperatingMode.EStop.IsActive AND NOT
																								OperatingMode.Fault.IsActive AND NOT
																								statMovePickPlace AND
																								statSetPointYAxis < 1.25;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].InPosition := statPickPlaceInPositionYAxis;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].CaptionButton := 'Plus';
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].PathImageButton := 'Images\UpElevator.svg';
		
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].IsVisibleButton := TRUE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].IsVisibleAxisPosition := TRUE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].IsEnabled := OperatingMode.ManuelIsActive;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].InPosition := NOT statMovePickPlace;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].AxisPosition := statCurrentPositionYAxis;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].CaptionButton := 'Stop';
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].PathImageButton := 'Images\StopConveyor.svg';
		
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].IsVisibleButton := TRUE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].IsVisibleAxisPosition := FALSE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].IsEnabled := OperatingMode.ManuelIsActive AND NOT
										 														OperatingMode.EStop.IsActive AND NOT
																								OperatingMode.Fault.IsActive AND NOT
																								statMovePickPlace AND
																								statSetPointYAxis > 0;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].InPosition := statPickPlaceInPositionYAxis;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].CaptionButton := 'Minus';
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].PathImageButton := 'Images\DownElevator.svg';
	
	ELSIF internHMIInterface.PageSwitch.SelectedPage = 2 THEN
		internHMIInterface.Movements.MovementSettingLines[1].CaptionSettingLine := CONCAT('StackerCrane Z-Axis Control ', ActorInstanceName);
		internHMIInterface.Movements.MovementSettingLines[1].VisibilitySettingLine := TRUE;
		
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].IsVisibleButton := TRUE;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].IsVisibleAxisPosition := FALSE;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].IsEnabled := OperatingMode.ManuelIsActive AND NOT
										 														OperatingMode.EStop.IsActive AND NOT
																								OperatingMode.Fault.IsActive AND NOT
																								statMovePickPlace AND
																								statSetPointZAxis < 0.5;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].InPosition := statPickPlaceInPositionZAxis;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].CaptionButton := 'Up';
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].PathImageButton := 'Images\UpElevator.svg';
		
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].IsVisibleButton := TRUE;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].IsVisibleAxisPosition := TRUE;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].IsEnabled := OperatingMode.ManuelIsActive;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].InPosition := NOT statMovePickPlace;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].AxisPosition := statCurrentPositionZAxis;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].CaptionButton := 'Stop';
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].PathImageButton := 'Images\StopConveyor.svg';
		
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].IsVisibleButton := TRUE;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].IsVisibleAxisPosition := FALSE;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].IsEnabled := OperatingMode.ManuelIsActive AND NOT
										 														OperatingMode.EStop.IsActive AND NOT
																								OperatingMode.Fault.IsActive AND NOT
																								statMovePickPlace AND
																								statSetPointZAxis > 0;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].InPosition := statPickPlaceInPositionZAxis;
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].CaptionButton := 'Down';
		internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].PathImageButton := 'Images\DownElevator.svg';
		
		internHMIInterface.Movements.MovementSettingLines[2].CaptionSettingLine := CONCAT('StackerCrane C-Axis Control ', ActorInstanceName);
		internHMIInterface.Movements.MovementSettingLines[2].VisibilitySettingLine := TRUE;
		
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].IsVisibleButton := TRUE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].IsVisibleAxisPosition := FALSE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].IsEnabled := OperatingMode.ManuelIsActive AND NOT
										 														OperatingMode.EStop.IsActive AND NOT
																								OperatingMode.Fault.IsActive AND NOT
																								statMovePickPlace;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].InPosition := statPickPlaceInPositionCAxis90;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].CaptionButton := '90°';
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].PathImageButton := '';
		
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].IsVisibleButton := FALSE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].IsVisibleAxisPosition := FALSE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].IsEnabled := FALSE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].InPosition := FALSE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].AxisPosition := 0;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].CaptionButton := '';
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].PathImageButton := '';
		
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].IsVisibleButton := TRUE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].IsVisibleAxisPosition := FALSE;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].IsEnabled := OperatingMode.ManuelIsActive AND NOT
										 														OperatingMode.EStop.IsActive AND NOT
																								OperatingMode.Fault.IsActive AND NOT
																								statMovePickPlace;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].InPosition := NOT statPickPlaceInPositionCAxis90;
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].CaptionButton := '0°';
		internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].PathImageButton := '';	
		END_IF
		
		internHMIInterface.Forks.ForkMovementSettingLines[1].CaptionSettingLine := CONCAT('Fork Control ', ActorInstanceName);
		internHMIInterface.Forks.ForkMovementSettingLines[1].VisibilitySettingLine := TRUE;
		
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[1].IsVisibleButton := TRUE;
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[1].IsVisibleAxisPosition := FALSE;
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[1].IsEnabled := OperatingMode.ManuelIsActive AND NOT
										 														OperatingMode.EStop.IsActive AND NOT
																								OperatingMode.Fault.IsActive AND NOT
																								statMovePickPlace AND
																								statPickPlaceInPositionXAxis AND
																								statPickPlaceInPositionYAxis AND
																								statPickPlaceInPositionZAxis;
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[1].InPosition := FALSE;
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[1].CaptionButton := 'Grap';
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[1].PathImageButton := '';
		
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[2].IsVisibleButton := FALSE;
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[2].IsVisibleAxisPosition := FALSE;
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[2].IsEnabled := FALSE;
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[2].InPosition := FALSE;
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[2].CaptionButton := '';
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[2].PathImageButton := '';
		
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[3].IsVisibleButton := TRUE;
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[3].IsVisibleAxisPosition := FALSE;
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[3].IsEnabled := OperatingMode.ManuelIsActive AND NOT
										 														OperatingMode.EStop.IsActive AND NOT
																								OperatingMode.Fault.IsActive AND NOT
																								statMovePickPlace AND
																								statPickPlaceInPositionXAxis AND
																								statPickPlaceInPositionYAxis AND
																								statPickPlaceInPositionZAxis;
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[3].InPosition := FALSE;
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[3].CaptionButton := 'Release';
		internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[3].PathImageButton := '';
	
	(*===================== X-Axis Plus =====================*)
	internRisingEdgePressButtonPlusXAxis(CLK := internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].IsPressed AND 
												internHMIInterface.PageSwitch.SelectedPage = 1 AND 
												internHMIInterface.PageSwitch.SelectedTab = 'tbMovement');
	IF internRisingEdgePressButtonPlusXAxis.Q THEN
		statSetPointXAxis := statSetPointXAxis + 0.2;
		statMovePickPlace := TRUE;
	END_IF
	(*===================== X-Axis Minus =====================*)
	internRisingEdgePressButtonMinusXAxis(CLK := internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].IsPressed AND 
												internHMIInterface.PageSwitch.SelectedPage = 1 AND 
												internHMIInterface.PageSwitch.SelectedTab = 'tbMovement');
	IF internRisingEdgePressButtonMinusXAxis.Q THEN
		statSetPointXAxis := statSetPointXAxis - 0.2;
		statMovePickPlace := TRUE;
	END_IF
	(*===================== X-Axis Stop =====================*)
	internRisingEdgePressButtonStopXAxis(CLK := internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].IsPressed AND 
												internHMIInterface.PageSwitch.SelectedPage = 1 AND 
												internHMIInterface.PageSwitch.SelectedTab = 'tbMovement');
	IF internRisingEdgePressButtonStopXAxis.Q THEN
		internStopXAxis := TRUE;
	END_IF
	(*===================== Y-Axis Plus =====================*)
	internRisingEdgePressButtonPlusYAxis(CLK := internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].IsPressed AND 
												internHMIInterface.PageSwitch.SelectedPage = 1 AND 
												internHMIInterface.PageSwitch.SelectedTab = 'tbMovement');
	IF internRisingEdgePressButtonPlusYAxis.Q THEN
		statSetPointYAxis := statSetPointYAxis + 0.2;
		statMovePickPlace := TRUE;
	END_IF
	(*===================== Y-Axis Minus =====================*)
	internRisingEdgePressButtonMinusYAxis(CLK := internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].IsPressed AND 
												internHMIInterface.PageSwitch.SelectedPage = 1 AND 
												internHMIInterface.PageSwitch.SelectedTab = 'tbMovement');
	IF internRisingEdgePressButtonMinusYAxis.Q THEN
		statSetPointYAxis := statSetPointYAxis - 0.2;
		statMovePickPlace := TRUE;
	END_IF
	(*===================== Y-Axis Stop =====================*)
	internRisingEdgePressButtonStopYAxis(CLK := internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[2].IsPressed AND 
												internHMIInterface.PageSwitch.SelectedPage = 1 AND 
												internHMIInterface.PageSwitch.SelectedTab = 'tbMovement');
	IF internRisingEdgePressButtonStopYAxis.Q THEN
		internStopYAxis := TRUE;
	END_IF
	(*===================== Z-Axis Up =====================*)
	internRisingEdgePressButtonUpZAxis(CLK := internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[1].IsPressed AND 
												internHMIInterface.PageSwitch.SelectedPage = 2 AND 
												internHMIInterface.PageSwitch.SelectedTab = 'tbMovement');
	IF internRisingEdgePressButtonUpZAxis.Q THEN
		statSetPointZAxis := statSetPointZAxis + 0.2;
		statMovePickPlace := TRUE;
	END_IF
	(*===================== Z-Axis Down =====================*)
	internRisingEdgePressButtonDownZAxis(CLK := internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[3].IsPressed AND 
												internHMIInterface.PageSwitch.SelectedPage = 2 AND 
												internHMIInterface.PageSwitch.SelectedTab = 'tbMovement');
	IF internRisingEdgePressButtonDownZAxis.Q THEN
		statSetPointZAxis := statSetPointZAxis - 0.2;
		statMovePickPlace := TRUE;
	END_IF
	(*===================== Z-Axis Stop =====================*)
	internRisingEdgePressButtonStopZAxis(CLK := internHMIInterface.Movements.MovementSettingLines[1].SettingLineButtons[2].IsPressed AND 
												internHMIInterface.PageSwitch.SelectedPage = 2 AND 
												internHMIInterface.PageSwitch.SelectedTab = 'tbMovement');
	IF internRisingEdgePressButtonStopZAxis.Q THEN
		internStopZAxis := TRUE;
	END_IF
	(*===================== C-Axis To 90 =====================*)
	internRisingEdgePressButtonCAxisToPos90(CLK := internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[1].IsPressed);
	IF internRisingEdgePressButtonCAxisToPos90.Q THEN
		statCAxisToPos90 := TRUE;
	END_IF
	(*===================== C-Axis To 0 =====================*)
	internRisingEdgePressButtonCAxisToPos0(CLK := internHMIInterface.Movements.MovementSettingLines[2].SettingLineButtons[3].IsPressed);
	IF internRisingEdgePressButtonCAxisToPos0.Q THEN
		statCAxisToPos90 := FALSE;
	END_IF
	(*===================== Grab Part =====================*)
	internRisingEdgePressButtonGrabPart(CLK := internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[1].IsPressed);
	IF internRisingEdgePressButtonGrabPart.Q THEN
		statGrabPart := TRUE;
	END_IF
	(*===================== Release Part =====================*)
	internRisingEdgePressButtonReleasePart(CLK := internHMIInterface.Forks.ForkMovementSettingLines[1].SettingLineButtons[3].IsPressed);
	IF internRisingEdgePressButtonReleasePart.Q THEN
		statGrabPart := FALSE;
	END_IF
	(*===================== Write Interface =====================*)
	HMIInterface := internHMIInterface;
ELSE
		internInstanceActivatedFirstTime := FALSE;
END_IF
(*===================== Stacker crane in Position =====================*)
statREX_YAxisMoving(CLK := PickPlaceX_YAxisStillMoving);
statFEX_YAxisMoving(CLK := PickPlaceX_YAxisStillMoving);
statREZAxisMoving(CLK := PickPlaceZAxisStillMoving);
statFEZAxisMoving(CLK := PickPlaceZAxisStillMoving);
statRECAxisMoving(CLK := PickPlaceCAxisLimitReached);
statFECAxisMoving(CLK := PickPlaceCAxisLimitReached);

IF statREX_YAxisMoving.Q THEN
	statPickPlaceInPositionXAxis := FALSE;
	statPickPlaceInPositionYAxis := FALSE;
END_IF
IF statFEX_YAxisMoving.Q THEN
	statPickPlaceInPositionXAxis := TRUE;
	statPickPlaceInPositionYAxis := TRUE;
END_IF
IF statREZAxisMoving.Q THEN
	statPickPlaceInPositionZAxis := FALSE;
END_IF
IF statFEZAxisMoving.Q THEN
	statPickPlaceInPositionZAxis := TRUE;
END_IF
IF statRECAxisMoving.Q THEN
	statPickPlaceInPositionCAxis90 := TRUE;
END_IF
IF statFECAxisMoving.Q THEN
	statPickPlaceInPositionCAxis90 := FALSE;
END_IF
(*===================== Positioning Stacker crane =====================*)
IF ((OperatingMode.AutomaticIsActive AND OperatingMode.AutomaticStart.IsActive) OR
	(OperatingMode.ManuelIsActive)) 
   AND statMovePickPlace 
THEN
	statSelectedSetPointXAxis := statSetPointXAxis;
	statSelectedSetPointYAxis := statSetPointYAxis;
	statSelectedSetPointZAxis := statSetPointZAxis;
END_IF
IF OperatingMode.EStop.IsActive OR OperatingMode.Fault.IsActive OR 
((OperatingMode.AutomaticIsActive AND OperatingMode.AutomaticStop.IsActive) OR
(OperatingMode.ManuelIsActive AND (internStopXAxis OR internStopZAxis)))
THEN
	statSelectedSetPointXAxis := statCurrentPositionXAxis;
	statSelectedSetPointYAxis := statCurrentPositionYAxis;
	statSelectedSetPointZAxis := statCurrentPositionZAxis;
	statMovePickPlace := FALSE;
END_IF
(*===================== SetPoint X-Axis =====================*)
FC_AnalogOutputValueHandling(Setpoint:= statSelectedSetPointXAxis, 
						     UpperLimit:= 2.125, 
							 LowerLimit:= 0.0, 
							 ConvertedValue=> statSetPointToXaxis);
(*===================== SetPoint Y-Axis =====================*)
FC_AnalogOutputValueHandling(Setpoint:= statSelectedSetPointYAxis, 
						     UpperLimit:= 1.25, 
							 LowerLimit:= 0.0, 
							 ConvertedValue=> statSetPointToYaxis);
(*===================== SetPoint Z-Axis =====================*)
FC_AnalogOutputValueHandling(Setpoint:= statSelectedSetPointZAxis, 
						     UpperLimit:= 0.5, 
							 LowerLimit:= 0.0, 
							 ConvertedValue=> statSetPointToZaxis);
(*===================== Outputs writting =====================*)
SetPointToXAxis := statSetPointToXaxis;
SetPointToYAxis := statSetPointToYaxis;
SetPointToZAxis := statSetPointToZaxis;
GrabPart := statGrabPart;
RotateGripper := statCAxisToPos90;]]></ST>
    </Implementation>
    <Method Name="GrabPart" Id="{0d434932-c9b0-4b95-9068-ff5f65ea57f3}">
      <Declaration><![CDATA[METHOD PUBLIC GrabPart : BOOL
VAR_INPUT
	StartGrabPart	:	BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF OperatingMode.AutomaticIsActive AND OperatingMode.AutomaticStart.IsActive AND
	InPositionX_Y_Axis AND InPositionZAxis AND StartGrabPart AND NOT statMovePickPlace 
THEN
	statGrabPart := TRUE;
	GrabPart := TRUE;
ELSE
	GrabPart := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="GripperInPos0" Id="{e3fcaf1e-2963-4a21-b05c-ef6adf9da007}">
