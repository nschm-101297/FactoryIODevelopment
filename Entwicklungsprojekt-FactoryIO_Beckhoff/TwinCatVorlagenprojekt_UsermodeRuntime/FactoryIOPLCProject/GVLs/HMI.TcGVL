														'SubParts'
													];
	hmiConveyorInstances	:	ARRAY[0..1] OF STRING := [
															'Foerderband 6',
															'Zufuehrung'
														 ];
	hmiElevatorInstances	:	ARRAY[0..1] OF STRING := [
															'Einlauf',
															'Hochregallager'
														];
	hmiStackerCraneInstances	:	ARRAY[0..1] OF STRING := [
															'Einlagerung',
															'Auslagerung'
														 ];		
	hmiRFIDInstances	:	ARRAY[0..2] OF STRING := [
															'Einlagerung',
															'Zufuehrung',
															'Warehouse-Infeed'
														 ];	
	hmiPositingBarInstances	:	ARRAY[0..2] OF STRING := [
															'Blau laden',
															'Gruen laden',
															'Grau laden'
														 ];										 
	
END_VAR]]></Declaration>
  </GVL>
