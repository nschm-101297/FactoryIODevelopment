<UserControl x:Class="FactoryIOHMI.Views.OperatingmodeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FactoryIOHMI.Views"
             mc:Ignorable="d" 
             Background="Beige"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="BTNStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                             Padding="{TemplateBinding Padding}"
                             VerticalAlignment="{TemplateBinding VerticalAlignment}"
                             HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                             CornerRadius="15"
                             SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ComboBox Grid.Row="0" Name="cbxGroupNameMachine"
                  ItemsSource="{Binding MachineSegmentsOperatingMode,
                                        Mode=OneWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="GroupNameMachine"
                  />
        <GroupBox Grid.Row="1"
                  Header="Betriebsart"
                  DataContext="{Binding Path=SelectedItem, ElementName=cbxGroupNameMachine}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BTNStyle}" Content="Manuel"
                        Command="{Binding Manuel}"/>
                <Button Style="{StaticResource BTNStyle}" Content="Automatik"
                        Command="{Binding Automatic}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="2"
          Header="Grundfunktionen"
                  DataContext="{Binding Path=SelectedItem, ElementName=cbxGroupNameMachine}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BTNStyle}" Content="Start"
                        Command="{Binding Start}"/>
                <Button Style="{StaticResource BTNStyle}" Content="Stop"
                        Command="{Binding Stop}"/>
                <Button Style="{StaticResource BTNStyle}" Content="Grundstellung"
                        Command="{Binding Homing}"/>
                <Button Style="{StaticResource BTNStyle}" Content="Reset"
                        Command="{Binding Reset}"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
