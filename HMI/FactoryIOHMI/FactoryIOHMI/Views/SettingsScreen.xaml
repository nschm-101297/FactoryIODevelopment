<UserControl x:Class="FactoryIOHMI.Views.SettingsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FactoryIOHMI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Beige">
    <UserControl.Resources>
        <Style TargetType="Image">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="50"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Beige"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <TabControl TabStripPlacement="Left" Background="Beige">
            <TabItem>
                <TabItem.Header>
                    <Image Source="/Images/Verbindung.png"/>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Label Grid.Column="0" Grid.Row="0"
                           Content="Verbindungsstatus: "/>
                    <Label Grid.Column="1" Grid.Row="0"
                           BorderBrush="Black"
                           BorderThickness="2"
                           Content="Verbindungsstatus: "/>
                    <Label Grid.Column="0" Grid.Row="1"
                           Content="AMS-NET-ID: "/>
                    <Label Grid.Column="1" Grid.Row="1"
                           BorderBrush="Black"
                           BorderThickness="2"
                           Content="Verbindungsstatus: "/>
                    <Label Grid.Column="0" Grid.Row="2"
                           Content="Portnummer: "/>
                    <Label Grid.Column="1" Grid.Row="2"
                           BorderBrush="Black"
                           BorderThickness="2"
                           Content="Verbindungsstatus: "/>
                    <Label Grid.Column="0" Grid.Row="3"
                           Content="Timeout: "/>
                    <Label Grid.Column="1" Grid.Row="3"
                           BorderBrush="Black"
                           BorderThickness="2"
                           Content="Verbindungsstatus: "/>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <Image Source="/Images/Monitor.png"/>
                </TabItem.Header>
                <Button HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent">
                    <StackPanel>
                        <Image Source="/Images/RuntimeBeenden.png" 
                               Stretch="Uniform"
                               Width="80"/>
                        <Label Content="Runtime beenden"/>
                    </StackPanel>
                </Button>
            </TabItem>
        </TabControl>      
    </Grid>
</UserControl>
