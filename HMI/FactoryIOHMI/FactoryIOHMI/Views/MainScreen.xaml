<Window x:Class="FactoryIOHMI.Views.MainScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FactoryIOHMI.Views"
        mc:Ignorable="d"
        Title="MainScreen" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="Bedinung" Margin="5" MinWidth="100"
                  BorderBrush="Black" BorderThickness="2">
            <StackPanel Orientation="Vertical">
                <Button Margin="5" Content="Main Screen"/>
                <Button Margin="5" Content="Connection"/>
                <Button Margin="5" Content="Runtime"/>
            </StackPanel>
        </GroupBox>
        <ContentControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</Window>
